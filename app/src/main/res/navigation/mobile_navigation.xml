<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.myapplication1.ui.home.HomeFragment"
        android:label="@string/menu_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_bookshelf"
        android:name="com.example.myapplication1.ui.bookshelf.BookshelfFragment"
        android:label="书架"
        tools:layout="@layout/fragment_bookshelf" />

    <fragment
        android:id="@+id/nav_chapterpreview"
        android:name="com.example.myapplication1.ui.chapterpreview.ChapterPreviewFragment"
        android:label="章节预览"
        tools:layout="@layout/fragment_chapter_preview" />

    <fragment
        android:id="@+id/nav_reader"
        android:name="com.example.myapplication1.ui.reader.ReaderFragment"
        android:label="阅读器"
        tools:layout="@layout/fragment_reader">
        <action
            android:id="@+id/action_nav_reader_to_nav_read"
            app:destination="@id/nav_read" />
    </fragment>
        
    <fragment
        android:id="@+id/nav_read"
        android:name="com.example.myapplication1.ui.read.ReadFragment"
        android:label="阅读内容"
        tools:layout="@layout/fragment_read" />

</navigation>